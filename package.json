{
  "name": "cc-safety-net",
  "version": "1.0.6",
  "description": "A coding agent CLI hook - block destructive git and filesystem commands before execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cc-safety-net": "dist/bin/cc-safety-net.js",
    "ccsn": "dist/bin/cc-safety-net.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "audit:dependencies": "bun audit",
    "build": "bun run clean && bun run scripts/build.ts",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly --declaration",
    "build:schema": "bun run scripts/build-schema.ts",
    "verify:build": "bun run scripts/verify-deterministic-build.ts",
    "verify:package": "bun run scripts/verify-package.ts",
    "verify:repository-plugin": "bun run scripts/verify-repository-plugin.ts",
    "verify:residual-risk": "bun run scripts/validate-residual-risk.ts",
    "verify:coverage": "bun run scripts/verify-coverage.ts",
    "clean": "rm -rf dist",
    "check": "bun run lint && bun run typecheck && bun run knip && bun run check-duplicates && bun run sg:scan && bun run verify:residual-risk && bun run test:coverage && bun run verify:coverage",
    "check:ci": "bun run lint:ci && bun run typecheck && bun run knip && bun run check-duplicates && bun run sg:scan && bun run verify:residual-risk && bun run test:coverage && bun run verify:coverage",
    "lint": "biome check --write",
    "lint:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "knip": "knip --production",
    "check-duplicates": "bunx jscpd src tests --noTips --exitCode 1 --reporters ai",
    "sg:scan": "ast-grep scan",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e",
    "test:e2e:stability": "bun test tests/e2e --randomize --rerun-each 3",
    "test:coverage": "AGENT=1 bun test tests --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "cc-safety-net": "bun run src/bin/cc-safety-net.ts",
    "prepare": "husky && bun run setup-hooks",
    "setup-hooks": "chmod +x .husky/pre-commit .husky/pre-push"
  },
  "author": {
    "name": "J Liew",
    "email": "jliew@420024lab.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenryu42/cc-safety-net.git"
  },
  "bugs": {
    "url": "https://github.com/kenryu42/cc-safety-net/issues"
  },
  "homepage": "https://ccsafetynet.com",
  "devDependencies": {
    "@ampcode/plugin": "0.0.0-20260724002649-ga3413e7",
    "@ast-grep/cli": "^0.40.4",
    "@biomejs/biome": "2.3.10",
    "@opencode-ai/plugin": "^1.18.3",
    "@types/bun": "latest",
    "@types/shell-quote": "^1.7.5",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "^5.79.0",
    "lint-staged": "^16.2.7",
    "shell-quote": "^1.10.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi/index.js"
    ]
  },
  "dependencies": {
    "zod": "4.3.5"
  },
  "overrides": {
    "picomatch@^2.3.1": "2.3.2",
    "picomatch@^4.0.1": "^4.0.5",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "claude-code",
    "opencode",
    "safety",
    "plugin",
    "security",
    "pi-package",
    "cursor",
    "amp"
  ]
}
